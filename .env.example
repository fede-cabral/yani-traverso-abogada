# ─────────────────────────────────────────────────────────────
#  Copiar a .env.local y completar. NUNCA commitear .env.local
# ─────────────────────────────────────────────────────────────

# PÚBLICAS — viajan al navegador, cualquiera las puede leer.
# Lo único que protege la base con la clave anon es RLS.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Dominio público del sitio (sin barra final). Se usa para canonical, sitemap y OG.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp del estudio en formato internacional, solo dígitos.
# Argentina: 54 + 9 + área sin 0 + número sin 15.
# Vacío a propósito: si te lo olvidás, el sitio no arranca y te dice qué
# falta, en vez de mandarle las consultas al número equivocado.
NEXT_PUBLIC_WHATSAPP=

# ─────────────────────────────────────────────────────────────
#  PRIVADAS — SOLO SERVIDOR. Nunca con prefijo NEXT_PUBLIC_.
# ─────────────────────────────────────────────────────────────

# Saltea RLS por completo. Es la llave maestra de la base.
# Si esta clave llega al navegador, la base está comprometida.
SUPABASE_SERVICE_ROLE_KEY=
